# Maintainer: Roberto Flores <robert-flo>
pkgname=ravn-webapps
pkgver=1.1.1
pkgrel=1
pkgdesc='Lanzadores web/TUI, iconos y launcher de la workstation RaVN (antes applications/ del fork)'
arch=('any')
url='https://github.com/robert-flo/ravn-webapps'
license=('MIT')
options=('!debug')
depends=('bash' 'hicolor-icon-theme')
optdepends=('chromium: navegador para las webapps' 'uwsm: aislamiento de apps en cgroups')
# Fuente privada: tarball vendoreado (git archive --prefix=${pkgname}-${pkgver}/
# v${pkgver} | gzip -n), así makepkg no necesita credenciales de GitHub.
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('3ad46bd7a8ab3cb6050105f592f9b869dace7de2d9be0c509a1749b90b82cabf')

package() {
  make -C "${srcdir}/${pkgname}-${pkgver}" DESTDIR="${pkgdir}" install
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
